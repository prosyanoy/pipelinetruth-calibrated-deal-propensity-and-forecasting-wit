# All values are optional; these are the defaults.
PT_DATA_DIR=data
PT_ARTIFACT_DIR=artifacts
PT_SEED=42
PT_N_OPPS=7000
PT_SNAPSHOT_DAYS=14
PT_INTERVAL_LEVEL=0.8
# MLflow uses an embedded SQLite backend by default; point at a server if you have one.
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
